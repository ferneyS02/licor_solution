<Window x:Class="Licoreria.Desktop.Views.ProductosWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Agregar productos" Height="650" Width="980"
        Background="#000000" WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- IZQUIERDA: Categorías -->
        <StackPanel Grid.RowSpan="2">
            <TextBlock Text="Categorías" Foreground="White" FontSize="16" Margin="0,0,0,8"/>

            <ListBox x:Name="LstCategorias"
                     Background="#0F0F0F" Foreground="White"
                     SelectionChanged="LstCategorias_SelectionChanged">

                <!-- ✅ Click derecho para cambiar alias (solo Admin/Sistema) -->
                <ListBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Cambiar nombre (alias)"
                                  Click="CambiarAliasCategoria_Click"/>
                    </ContextMenu>
                </ListBox.ContextMenu>
            </ListBox>
        </StackPanel>

        <!-- DERECHA: barra admin -->
        <StackPanel Grid.Column="1" Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,8">
            <CheckBox x:Name="ChkOrganizar" Content="Organizar"
                      Foreground="White" Margin="0,0,12,0"
                      Checked="ChkOrganizar_Checked" Unchecked="ChkOrganizar_Unchecked"/>
            <Button x:Name="BtnGuardarOrden" Content="Guardar orden"
                    Background="#D4AF37" Foreground="White"
                    IsEnabled="False"
                    Click="BtnGuardarOrden_Click"/>
        </StackPanel>

        <!-- DERECHA: productos -->
        <ScrollViewer x:Name="SvProductos" Grid.Column="1" Grid.Row="1">
            <WrapPanel x:Name="WrapProductos"/>
        </ScrollViewer>
    </Grid>
</Window>
