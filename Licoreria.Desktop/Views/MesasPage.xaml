<Page x:Class="Licoreria.Desktop.Views.MesasPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#000000"
      UseLayoutRounding="True"
      SnapsToDevicePixels="True">

    <Grid SnapsToDevicePixels="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Toolbar (solo Admin/Sistema) -->
        <Border x:Name="Toolbar" Grid.Row="0" Background="#0F0F0F" Padding="10" Margin="10" CornerRadius="10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <CheckBox x:Name="ChkEditar" Content="Editar distribución"
                          Foreground="White" Margin="0,0,12,0"
                          Checked="ChkEditar_Checked" Unchecked="ChkEditar_Unchecked"/>
                <Button x:Name="BtnGuardar" Content="Guardar"
                        Background="#D4AF37" Foreground="White"
                        IsEnabled="False" Margin="0,0,10,0"
                        Click="BtnGuardar_Click"/>
                <Button x:Name="BtnReset" Content="Reset"
                        Background="#222" Foreground="White"
                        Click="BtnReset_Click"/>
            </StackPanel>
        </Border>

        <!-- Zona layout -->
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <Canvas x:Name="LayoutCanvas"
                    Width="1200" Height="700"
                    Background="#000000"
                    SnapsToDevicePixels="True" />
        </ScrollViewer>
    </Grid>
</Page>
